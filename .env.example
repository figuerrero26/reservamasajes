# Copie este archivo a .env y ajuste los valores antes de desplegar.
# Nunca use estos valores de ejemplo en producción.

# --- Entorno ---
APP_ENV=production
APP_TIMEZONE=America/Bogota

# --- MariaDB ---
# El backend se conecta como 'root' de MariaDB (usuario por defecto del contenedor oficial;
# no se crea un usuario de aplicación aparte). MARIADB_PASSWORD debe ser igual a
# MARIADB_ROOT_PASSWORD. El backend arma la cadena de conexión a partir de estas variables
# (ver backend/app/config.py); no hace falta escribirla a mano, y así una contraseña con
# caracteres especiales (@, :, etc.) no rompe el parseo de la URL.
MARIADB_ROOT_PASSWORD=cambie-esta-clave
MARIADB_DATABASE=reservas
MARIADB_USER=root
MARIADB_PASSWORD=cambie-esta-clave

# --- Host de la base de datos ---
# Por defecto (DB_HOST=db) el backend se conecta al servicio 'db' de este mismo
# docker-compose.yml (comando estándar: docker compose up -d --build). Si este equipo NO
# aloja su propia MariaDB sino que usa la de otra máquina en la LAN, cambie DB_HOST a la IP
# de esa máquina, deje MARIADB_USER/MARIADB_PASSWORD/MARIADB_DATABASE iguales a los
# configurados allá, y levante la pila con docker-compose.client.yml en vez del archivo
# normal (ver README, sección "Base de datos compartida en la red local").
DB_HOST=db
DB_PORT=3306

# --- Seguridad ---
JWT_SECRET=genere-un-secreto-largo-y-aleatorio

# --- CORS (orígenes permitidos separados por coma) ---
CORS_ORIGINS=http://localhost:8080

# --- Puertos publicados en el host (cambie si ya están en uso en su servidor) ---
BACKEND_PORT=8001

# --- Administrador inicial (se crea/actualiza al iniciar el backend) ---
ADMIN_USER=admin
ADMIN_INITIAL_PASSWORD=cambie-esta-clave

# --- SMTP (confirmación de reservas por correo) ---
# Valor por defecto/fallback si no hay configuración guardada desde el panel admin
# (Configuración > SMTP). Con SMTP_HOST vacío, el sistema no envía correos: la reserva
# igual se crea y queda registrada como "pendiente" en la tabla notificaciones.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=no-reply@empresa.com
SMTP_FROM_NAME=Reservas de Bienestar

# --- Frontend (build-time, ver frontend/.env.example) ---
VITE_API_URL=/api/v1
