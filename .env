# Copie este archivo a .env y ajuste los valores antes de desplegar.
# Nunca use estos valores de ejemplo en producción.

# --- Entorno ---
APP_ENV=production
APP_TIMEZONE=America/Bogota

# --- MariaDB ---
# Este equipo NO usa su propia base para la app: se conecta a la MariaDB del servidor hades
# en la LAN. Levantar la pila con: docker compose up -d --build backend frontend
# (sin 'db', para no levantar una base local que quedaría sin uso).
DB_HOST=192.168.2.14
DB_PORT=3306
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=reservas
MARIADB_USER=root
MARIADB_PASSWORD=root

# --- Seguridad ---
JWT_SECRET=genere-un-secreto-largo-y-aleatorio

# --- CORS (orígenes permitidos separados por coma) ---
CORS_ORIGINS=http://localhost:8080

# --- Administrador inicial (se crea/actualiza al iniciar el backend) ---
ADMIN_USER=admin_sigra
ADMIN_INITIAL_PASSWORD=T3cn0z1gr@67!

# --- Frontend (build-time, ver frontend/.env.example) ---
VITE_API_URL=/api/v1
