# Copie este archivo a .env y ajuste los valores antes de desplegar.
# Nunca use estos valores de ejemplo en producción.

# --- Entorno ---
APP_ENV=production
APP_TIMEZONE=America/Bogota

# --- MariaDB ---
# DB_HOST NO se define aquí a propósito: este archivo se comparte por git entre hades y
# cualquier otro equipo, y cada uno necesita un DB_HOST distinto (hades usa 'db', el interno
# de este compose; otros equipos, la IP de hades). Por eso cada equipo define su propio
# DB_HOST como variable de entorno de shell (no en este archivo), que Docker Compose siempre
# prioriza sobre el valor del .env. Ver README, sección "Base de datos compartida en la red
# local".
DB_PORT=3306
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=reservas
MARIADB_USER=root
MARIADB_PASSWORD=root

# --- Seguridad ---
JWT_SECRET=genere-un-secreto-largo-y-aleatorio

# --- Portal público (para armar el enlace de "restablecer contraseña" en el correo) ---
# Un solo origen — si su equipo accede por la IP de hades en vez de localhost, cambie este
# valor localmente (no lo suba compartido si difiere entre equipos).
FRONTEND_URL=http://localhost:8080

# --- CORS (orígenes permitidos separados por coma) ---
# Incluye todos los orígenes desde los que se accede al frontend: localhost (equipos de
# desarrollo) y la IP de hades (acceso en la LAN). Agregue aquí cualquier dominio nuevo que
# use en el futuro (por ejemplo, uno con HTTPS al configurar Nginx Proxy Manager).
CORS_ORIGINS=http://localhost:8080,http://192.168.2.14:8080

# --- Administrador inicial (se crea/actualiza al iniciar el backend) ---
ADMIN_USER=tecnologia@sigra.com
ADMIN_INITIAL_PASSWORD=1

# --- Frontend (build-time, ver frontend/.env.example) ---
VITE_API_URL=/api/v1
