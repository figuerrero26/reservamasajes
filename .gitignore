# Entorno
.env
.env.*
!.env.example
!frontend/.env.example

# Datos persistentes de MariaDB (bind mount de docker-compose.yml). Nunca se versiona:
# son los datos reales de la base (potencialmente con información personal) y archivos
# binarios grandes.
/data/

# Backend (Python)
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editores / SO
.DS_Store
.vscode/
.idea/

# Herramientas internas de desarrollo (worktrees de agentes, etc.)
.claude/
